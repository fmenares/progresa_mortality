. foreach ggrp in p m f {
  2.     foreach agecut in 65 51 {
  3.         if "`ggrp'" == "p"      local gcondp "!missing(age_wave) & age_wave>=`ag
> ecut'"
  4.         else if "`ggrp'" == "m" local gcondp "gender==1 & !missing(age_wave) & a
> ge_wave>=`agecut'"

  9. 
.         di "  [total_visits POOLED `agecut'+, g=`ggrp'] _b[contba] = " _b[contba] "
>   N=" e(N)
 10. 
.         local aux : di %9.3f _b[contba]
 11.         local tstat = abs(_b[contba] / _se[contba])
 12.         if      `tstat' >= 2.576 local b99_`ggrp'_tvp`agecut' = trim("`aux'") + 
> "***"
 13.         else if `tstat' >= 1.960 local b99_`ggrp'_tvp`agecut' = trim("`aux'") + 
> "**"
 14.         else if `tstat' >= 1.645 local b99_`ggrp'_tvp`agecut' = trim("`aux'") + 
> "*"
 15.         else                     local b99_`ggrp'_tvp`agecut' = trim("`aux'")
 16.         local se99_`ggrp'_tvp`agecut' : di %9.3f _se[contba]
 17.         local N_`ggrp'_tvp`agecut'    : di %12.0fc e(N)
 18.     }
 19. }

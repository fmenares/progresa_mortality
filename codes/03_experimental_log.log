 13.             if `tstat' >= 2.576      local b`yr'_`g'_`col' = trim("`aux'") + "**
> *"
 14.             else if `tstat' >= 1.960 local b`yr'_`g'_`col' = trim("`aux'") + "**
> "
 15.             else if `tstat' >= 1.645 local b`yr'_`g'_`col' = trim("`aux'") + "*"
 16.             else                     local b`yr'_`g'_`col' = trim("`aux'")
 17.             local se`yr'_`g'_`col' : di %9.3f _se[`yr'.year#1.contba]
 18.         }
 19.         local N_`g'_`col'   : di %12.0fc e(N)
 20.         local cmn_`g'_`col' : di %9.3f `cmean97_elig'
 21.     }
 22. }


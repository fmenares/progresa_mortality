. *============================================================
. * APPENDIX TABLE: HH Expenditures by Elderly Presence / Older-Adults-
. * Only Household Eligibility. Two-panel table (merged per the coauthor's
. * request; previously two separate tables, now merged into one file):
. *   Panel A -- Elderly Presence: full eligible-household sample,
. *     differential by whether the household has an elderly member
. *     (elderly97), computed just above.
. *   Panel B -- Older-Adults-Only Household: restricted to
. *     only_elderly_base==1, differential by household ELIGIBILITY
. *     instead, since only eligible households receive the direct food
. *     transfer (apoyo alimentario) -- computed in the loop right below.
. * Output: $tables/appendix/AT8_expenditures_elderly.tex
. *============================================================
. foreach yvar of local hh_outcomes {
  2.     local col ""
  3.     if "`yvar'" == "food"      local col food
  4.     if "`yvar'" == "porc_food" local col pf
  5.     if "`yvar'" == "medicine"  local col med
  6.     if "`yvar'" == "porc_med"  local col pm
  7.     if "`col'" != "" {
  8.         * Control mean 1998 for the ineligible control group
.         summarize `yvar' if year==98 & contba==0 & elig_bin==0 & only_elderly_base=
> =1 ///
>             & !missing(`yvar', year, contba, elig_bin, hhid, claveofi)
  9.         local cmn_et_`col' : di %9.3f r(mean)
 10. 
.         reghdfe `yvar' i.year##i.contba##i.elig_bin ///
>             if only_elderly_base==1 & !missing(`yvar', year, contba, elig_bin, hhid
> , claveofi), ///
>             absorb(clavemun) vce(cluster claveofi)
 11. 
.         * Treatment × 1999 for ineligible HH (base = 1998, elig_bin=0)
.         local aux : di %9.3f _b[99.year#1.contba]
 12.         local tstat = abs(_b[99.year#1.contba] / _se[99.year#1.contba])
 13.         if `tstat' >= 2.576      local b_et_`col' = trim("`aux'") + "***"
 14.         else if `tstat' >= 1.960 local b_et_`col' = trim("`aux'") + "**"
 15.         else if `tstat' >= 1.645 local b_et_`col' = trim("`aux'") + "*"
 16.         else                     local b_et_`col' = trim("`aux'")
 17.         local se_et_`col' : di %9.3f _se[99.year#1.contba]
 18.         * Differential for eligible HH (triple interaction)
.         local aux : di %9.3f _b[99.year#1.contba#1.elig_bin]
 19.         local tstat = abs(_b[99.year#1.contba#1.elig_bin] / _se[99.year#1.contba
> #1.elig_bin])
 20.         if `tstat' >= 2.576      local be_et_`col' = trim("`aux'") + "***"
 21.         else if `tstat' >= 1.960 local be_et_`col' = trim("`aux'") + "**"
 22.         else if `tstat' >= 1.645 local be_et_`col' = trim("`aux'") + "*"
 23.         else                     local be_et_`col' = trim("`aux'")
 24.         local see_et_`col' : di %9.3f _se[99.year#1.contba#1.elig_bin]
 25.         local N_et_`col'  : di %12.0fc e(N)
 26.     }
 27. }


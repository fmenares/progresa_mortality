. local hh_outcomes food porc_food medicine porc_med

. foreach yvar of local hh_outcomes {
  2. 
.     * Control mean in 1998 (control localities), matching the estimation sample
.      summarize `yvar' if year==98 & contba==0 & !missing(`yvar', year, contba, hhid
> , claveofi)
  3.     local cmean97_all = r(mean)
  4. 
.     * Full sample
.     reghdfe `yvar' i.year##i.contba ///
>         if !missing(`yvar', year, contba, hhid, claveofi), ///
>         absorb(clavemun) ///
>         vce(cluster claveofi)
  5.     estadd scalar cmean97 = `cmean97_all'
  6.     eststo `yvar'_all
  7. 
.     * Control mean in 1997 for eligible households
.     quietly summarize `yvar' if year==98 & contba==0 & eligible==1 & !missing(`yvar
> ', year, contba, hhid, claveofi)
  8.     local cmean97_elig = r(mean)
  9. 
.     * Eligible households only
.     reghdfe `yvar' i.year##i.contba ///
>         if eligible==1 & !missing(`yvar', year, contba, hhid, claveofi), ///
>         absorb(clavemun) ///
>         vce(cluster claveofi)
 10.     estadd scalar cmean97 = `cmean97_elig'
 11.     eststo `yvar'_elig
 12. 
.     * Control mean in 1997 for heterogeneity regression (same as full sample)
.     * (reported as the overall control mean in 1997; the heterogeneity coefficients
>  are differences relative to this baseline)
.      summarize `yvar' if year==98 & contba==0 & !missing(`yvar', year, contba, elde
> rly97, hhid, claveofi)
 13.     local cmean97_het = r(mean)
 14. 
.     * Heterogeneity: households with elderly (elderly97) vs without
.      reghdfe `yvar' i.year##i.contba##i.elderly97 ///
>         if !missing(`yvar', year, contba, elderly97, hhid, claveofi), ///
>         absorb(clavemun) ///
>         vce(cluster claveofi)
 15.     estadd scalar cmean97 = `cmean97_het'
 16.     eststo `yvar'_het
 17. 
.     * Control mean in 1997 for eligible households (heterogeneity regression)
.      summarize `yvar' if year==98 & contba==0 & eligible==1 & !missing(`yvar', year
> , contba, elderly97, hhid, claveofi)
 18.     local cmean97_hetelig = r(mean)
 19. 
.      reghdfe `yvar' i.year##i.contba##i.elderly97 ///
>         if eligible==1 & !missing(`yvar', year, contba, elderly97, hhid, claveofi),
>  ///
>         absorb(clavemun) ///
>         vce(cluster claveofi)
 20.     estadd scalar cmean97 = `cmean97_hetelig'
 21.     eststo `yvar'_hetelig
 22. 
.     * Extract locals for AT6 table
.     local col ""
 23.     if "`yvar'" == "food"      local col food
 24.     if "`yvar'" == "porc_food" local col pf
 25.     if "`yvar'" == "medicine"  local col med
 26.     if "`yvar'" == "porc_med"  local col pm
 27.     if "`col'" != "" {
 28.         * Treatment × 1999 for non-elderly HH (base = 1998, elderly97=0)
.         local aux : di %9.3f _b[99.year#1.contba]
 29.         local tstat = abs(_b[99.year#1.contba] / _se[99.year#1.contba])
 30.         if `tstat' >= 2.576      local b99_`col' = trim("`aux'") + "***"
 31.         else if `tstat' >= 1.960 local b99_`col' = trim("`aux'") + "**"
 32.         else if `tstat' >= 1.645 local b99_`col' = trim("`aux'") + "*"
 33.         else                     local b99_`col' = trim("`aux'")
 34.         local se99_`col' : di %9.3f _se[99.year#1.contba]
 35.         * Differential for elderly HH (triple interaction)
.         local aux : di %9.3f _b[99.year#1.contba#1.elderly97]
 36.         local tstat = abs(_b[99.year#1.contba#1.elderly97] / _se[99.year#1.contb
> a#1.elderly97])
 37.         if `tstat' >= 2.576      local b99e_`col' = trim("`aux'") + "***"
 38.         else if `tstat' >= 1.960 local b99e_`col' = trim("`aux'") + "**"
 39.         else if `tstat' >= 1.645 local b99e_`col' = trim("`aux'") + "*"
 40.         else                     local b99e_`col' = trim("`aux'")
 41.         local se99e_`col' : di %9.3f _se[99.year#1.contba#1.elderly97]
 42.         local N_at6_`col'  : di %12.0fc e(N)
 43.         local cmn98_`col'  : di %9.3f `cmean97_hetelig'
 44.     }
 45. }


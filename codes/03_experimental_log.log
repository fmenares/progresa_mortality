. 
. 
.         foreach yvar of local living {
  2. 
.     * Control mean in 1997 (control localities), matching the estimation sample
.     summarize `yvar' if year==97 & contba==0 & !missing(`yvar', year, contba, clave
> ofi)
  3.     local cmean97_all = r(mean)
  4. 
.     * Full sample
.     reghdfe `yvar' i.year##i.contba ///
>         if !missing(`yvar', year, contba, claveofi), ///
>         absorb(pid) ///
>         vce(cluster clavemun)
  5.     estadd scalar cmean97 = `cmean97_all'
  6.     eststo `yvar'_all
  7. 
.     * Control mean in 1997 for eligible households
.     summarize `yvar' if year==97 & contba==0 & eligible==1 & !missing(`yvar', year,
>  contba, claveofi)
  8.     local cmean97_elig = r(mean)
  9. 
.     * Eligible households only
.     reghdfe `yvar' i.year##i.contba ///
>         if eligible==1 & !missing(`yvar', year, contba, claveofi), ///
>         absorb(clavemun) ///
>         vce(cluster claveofi)
 10.     estadd scalar cmean97 = `cmean97_elig'
 11.     eststo `yvar'_elig
 12. 
.     * Extract locals for T3 (living arrangement outcomes)
.     local col ""
 13.     if "`yvar'" == "live_alone"    local col la
 14.     if "`yvar'" == "with_children" local col wc
 15.     if "`yvar'" == "only_elderly"  local col oe
 16.     if "`col'" != "" {
 17.         foreach yr in 98 99 {
 18.             local aux : di %9.3f _b[`yr'.year#1.contba]
 19.             local tstat = abs(_b[`yr'.year#1.contba] / _se[`yr'.year#1.contba])
 20.             if `tstat' >= 2.576      local b`yr'_`g'_`col' = trim("`aux'") + "**
> *"
 21.             else if `tstat' >= 1.960 local b`yr'_`g'_`col' = trim("`aux'") + "**
> "
 22.             else if `tstat' >= 1.645 local b`yr'_`g'_`col' = trim("`aux'") + "*"
 23.             else                     local b`yr'_`g'_`col' = trim("`aux'")
 24.             local se`yr'_`g'_`col' : di %9.3f _se[`yr'.year#1.contba]
 25.         }
 26.         local N_`g'_`col'   : di %12.0fc e(N)
 27.         local cmn_`g'_`col' : di %9.3f `cmean97_elig'
 28.     }
 29. }


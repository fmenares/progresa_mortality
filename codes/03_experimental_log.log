> ar, contba, claveofi)
  3.     local cmean97_elig = r(mean)
  4.     reghdfe `yvar' i.year##i.contba ///
>         if eligible==1 & !missing(`yvar', year, contba, claveofi), ///
>         absorb(clavemun) ///
>         vce(cluster claveofi)
  5.     estadd scalar cmean97 = `cmean97_elig'
  6.     if "`yvar'" == "weekly_hours" {
  7.         di "  [weekly_hours, g=`g'] _b[98.year#1.contba] = " _b[98.year#1.contba
> ] "  _b[99.year#1.contba] = " _b[99.year#1.contba]
  8.         foreach yr in 98 99 {
  9.             local aux : di %9.3f _b[`yr'.year#1.contba]
 10.             local tstat = abs(_b[`yr'.year#1.contba] / _se[`yr'.year#1.contba])
 11.             if `tstat' >= 2.576      local b`yr'_`g'_wh = trim("`aux'") + "***"
 12.             else if `tstat' >= 1.960 local b`yr'_`g'_wh = trim("`aux'") + "**"
 13.             else if `tstat' >= 1.645 local b`yr'_`g'_wh = trim("`aux'") + "*"
 14.             else                     local b`yr'_`g'_wh = trim("`aux'")
 15.             local se`yr'_`g'_wh : di %9.3f _se[`yr'.year#1.contba]
 16.         }
 17.         local N_`g'_wh   : di %12.0fc e(N)
 18.         local cmn_`g'_wh : di %9.3f `cmean97_elig'
 19.         di "  -> b98_`g'_wh = `b98_`g'_wh'  b99_`g'_wh = `b99_`g'_wh'"
 20.     }
 21. }


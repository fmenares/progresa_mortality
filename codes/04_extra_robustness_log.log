. cloud_plot d_br dose_br w65_br 0 "AF_cloud_br_uw" ///
>         "BR treatment: mean lagged intensity, 2000-2002" ///
>         "Change in mortality rate 65+, 2000-2002 vs. 1992-1999" 1

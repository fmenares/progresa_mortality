  3.     local n1_`v' = r(N)
  4.     count if $sample_marg & year==1996 & `v'==0
  5.     local n0_`v' = r(N)
  6.     di "`v': `n1_`v'' high / `n0_`v'' low (HM municipalities, 1996)"
  7. }

. *============================================================
. * APPENDIX TABLE (former): Causes of Death (Weighted + SP spec)
. * AT2_cod_mortality.tex -- Pooled, Female, Male panels, at:did_robust_cod.
. * NOTE: the wyoung Romano-Wolf bootstrap (500 reps x 3 panels x 9
. * outcomes) is slow.
. *============================================================
. foreach grp in w f m {
  2.         if "`grp'" == "w" {
  3.                 local wvar = "popover65_"
  4.                 local suffix = ""
  5.         }
  6.         else if "`grp'" == "f" {
  7.                 local wvar = "popover65_f"
  8.                 local suffix = "f"
  9.         }
 10.         else {
 11.                 local wvar = "popover65_m"
 12.                 local suffix = "m"
 13.         }
 14. 
.         foreach cod in tb_card tb_infect tb_diab tb_resp tb_nutri tb_cancer tb_acci
> d tb_illdef tb_other {
 15.                 reghdfe emr65`cod'`suffix' c.inten1999#i.post c.inten2005#i.post
>  c.sp_intensity ///
>                         [aw=`wvar'] if $sample_marg, a(year cve_ent_mun_super) ///
>                         vce(cluster cve_ent_mun_super)
 16.                 local aux: di %12.3f _b[1.post#c.inten1999]
 17.                 local t = abs(_b[1.post#c.inten1999] / _se[1.post#c.inten1999])
 18.                 if      `t' >= 2.576 local b99_`grp'_`cod' = "`aux'***"
 19.                 else if `t' >= 1.96  local b99_`grp'_`cod' = "`aux'**"
 20.                 else if `t' >= 1.645 local b99_`grp'_`cod' = "`aux'*"
 21.                 else                  local b99_`grp'_`cod' = "`aux'"
 22.                 local se99_`grp'_`cod': di %12.3f _se[1.post#c.inten1999]
 23.                 * Intensity_2005 x post kept as a control (per the coauthor's
.                 * request) but not printed below -- no stand-alone interpretation.
.                 local aux: di %12.3f _b[1.post#c.inten2005]
 24.                 local t = abs(_b[1.post#c.inten2005] / _se[1.post#c.inten2005])
 25.                 if      `t' >= 2.576 local b05_`grp'_`cod' = "`aux'***"
 26.                 else if `t' >= 1.96  local b05_`grp'_`cod' = "`aux'**"
 27.                 else if `t' >= 1.645 local b05_`grp'_`cod' = "`aux'*"
 28.                 else                  local b05_`grp'_`cod' = "`aux'"
 29.                 local se05_`grp'_`cod': di %12.3f _se[1.post#c.inten2005]
 30.                 sum emr65`cod'`suffix' if e(sample) & post == 2
 31.                 local mean_`grp'_`cod': di %12.2fc `r(mean)'
 32.                 local N_`grp'_`cod': di %12.0fc `e(N)'
 33.                 distinct cve_ent_mun_super if e(sample)
 34.                 local Nmun_`grp'_`cod': di %12.0fc `r(ndistinct)'
 35.         }
 36. }

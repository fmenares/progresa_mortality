. *============================================================
. * MOVED FROM 02_mortality.do per the coauthor's request -- no longer
. * displayed in the paper (figures_app.tex/tables_app.tex entries
. * removed). Regressions/di diagnostics below still run so the numeric
. * results remain available for review; the `graph export'/`file
. * open...file close' lines are commented out so no .tex/.pdf is written
. * to figures/appendix or tables/appendix, per this file's convention.
. *============================================================
. 
. *============================================================
. * APPENDIX FIGURES AF4/AF5 (former): Event Study by Cause of Death
. * (Our Sample, 1991-2006), af:es_cod_marg_a / af:es_cod_marg_b.
. * y-axis -9(3)9 for tb_card, -6(3)6 otherwise.
. *============================================================
. {
. local yr_labels_cod `"1 "1991" 2 "1992" 3 "1993" 4 "1994" 5 "1995" 6 "1996" 7 "1997
> " 8 "1998" 9 "1999" 10 "2000" 11 "2001" 12 "2002" 13 "2003" 14 "2004" 15 "2005" 16 
> "2006""'
. local samp_cond  "$sample_marg"
. local samp_yr_cond ""
. local obs_n = 16
. local yr_pos_offset = 0
. local xscale_range "range(0.5 16.5)"
. local pos_start = 1
. local pos_end   = 16
. 
. foreach cod in tb_card tb_infect tb_diab tb_resp tb_nutri tb_cancer tb_accid tb_ill
> def tb_other {
  2. 
.         * Output stem per cause of death: af:es_cod_marg_a (former Appendix
.         * Figure AF4) takes cancer/diab/illdef/resp; af:es_cod_marg_b (AF5)
.         * takes card/infect/nutri/accid; tb_other isn't in either, so it
.         * keeps its old Figure_3 stem (not part of the renumbered set).
.         if      "`cod'" == "tb_cancer" local af_stem "AF4a_tb_cancer_Marg"
  3.         else if "`cod'" == "tb_diab"   local af_stem "AF4b_tb_diab_Marg"
  4.         else if "`cod'" == "tb_illdef" local af_stem "AF4c_tb_illdef_Marg"
  5.         else if "`cod'" == "tb_resp"   local af_stem "AF4d_tb_resp_Marg"
  6.         else if "`cod'" == "tb_card"   local af_stem "AF5a_tb_card_Marg"
  7.         else if "`cod'" == "tb_infect" local af_stem "AF5b_tb_infect_Marg"
  8.         else if "`cod'" == "tb_nutri"  local af_stem "AF5c_tb_nutri_Marg"
  9.         else if "`cod'" == "tb_accid"  local af_stem "AF5d_tb_accid_Marg"
 10.         else                            local af_stem "Figure_3_`cod'_Marg"
 11. 
.         foreach grp in w f m {
 12.                 local reg_success_`grp' = 0
 13.                 if "`grp'" == "w" {
 14.                         local outcome emr65`cod'
 15.                         local wvar   popover65_
 16.                 }
 17.                 else if "`grp'" == "f" {
 18.                         local outcome emr65`cod'f
 19.                         local wvar   popover65_f
 20.                 }
 21.                 else {
 22.                         local outcome emr65`cod'm
 23.                         local wvar   popover65_m
 24.                 }
 25.                 capture noisily reghdfe `outcome' c.inten1999##ib6.year_1995 c.i
> nten2005##ib6.year_1995 ///
>                         c.sp_intensity [aw=`wvar'] if `samp_cond', ///
>                         a(year cve_ent_mun_super) vce(cluster cve_ent_mun_super)
 26.                 if _rc == 0 {
 27.                         local reg_success_`grp' = 1
 28.                         forval pos = `pos_start'/`pos_end' {
 29.                                 if `pos' == 6 {
 30.                                         local b_`grp'_`pos'  = 0
 31.                                         local se_`grp'_`pos' = 0
 32.                                 }
 33.                                 else {
 34.                                         local b_`grp'_`pos'  = _b[`pos'.year_199
> 5#c.inten1999]
 35.                                         local se_`grp'_`pos' = _se[`pos'.year_19
> 95#c.inten1999]
 36.                                 }
 37.                         }
 38.                 }
 39.                 else {
 40.                         di "WARNING: Regression failed for `outcome' (`cod', Mar
> g sample) - skipping"
 41.                         forval pos = `pos_start'/`pos_end' {
 42.                                 local b_`grp'_`pos'  = .
 43.                                 local se_`grp'_`pos' = .
 44.                         }
 45.                 }
 46.         }
 47. 
.         preserve
 48.         clear
 49.         set obs `obs_n'
 50.         gen yr_pos = _n + `yr_pos_offset'
 51.         gen xpos_w = yr_pos - 0.18
 52.         gen xpos_f = yr_pos
 53.         gen xpos_m = yr_pos + 0.18
 54.         foreach grp in w f m {
 55.                 gen b_`grp'  = .
 56.                 gen hi_`grp' = .
 57.                 gen lo_`grp' = .
 58.         }
 59.         forval pos = `pos_start'/`pos_end' {
 60.                 foreach grp in w f m {
 61.                         if `reg_success_`grp'' == 1 {
 62.                                 replace b_`grp'  = `b_`grp'_`pos''              
>               if yr_pos == `pos'
 63.                                 replace hi_`grp' = `b_`grp'_`pos'' + 1.96 * `se_
> `grp'_`pos'' if yr_pos == `pos'
 64.                                 replace lo_`grp' = `b_`grp'_`pos'' - 1.96 * `se_
> `grp'_`pos'' if yr_pos == `pos'
 65.                         }
 66.                 }
 67.         }
 68. 
.         if inlist("`cod'", "tb_cancer", "tb_diab", "tb_illdef", "tb_infect") {
 69.                 local yaxis_range "-6(3)3"
 70.         }
 71.         else if "`cod'" == "tb_card" {
 72.                 local yaxis_range "-9(3)9"
 73.         }
 74.         else {
 75.                 local yaxis_range "-6(3)6"
 76.         }
 77. 
.         local twoway_cmd "twoway"
 78.         local legend_nums ""
 79.         local legend_labels ""
 80.         local plot_count = 0
 81.         if `reg_success_w' == 1 {
 82.                 local twoway_cmd "`twoway_cmd' (rcap hi_w lo_w xpos_w, lcolor(bl
> ack%60) lwidth(vthin)) (scatter b_w xpos_w, mcolor(black) msymbol(circle) msize(vsm
> all)) (line b_w xpos_w if 1==0, lcolor(black) lpattern(solid) lwidth(thin))"
 83.                 local plot_count = `plot_count' + 3
 84.                 local legend_nums "`legend_nums' `plot_count'"
 85.                 local legend_labels "`legend_labels' label(`plot_count' Pooled)"
 86.         }
 87.         if `reg_success_f' == 1 {
 88.                 local twoway_cmd "`twoway_cmd' (rcap hi_f lo_f xpos_f, lcolor(re
> d%60) lwidth(vthin)) (scatter b_f xpos_f, mcolor(red%60) msymbol(square) msize(vsma
> ll)) (line b_f xpos_f if 1==0, lcolor(red%60) lpattern(solid) lwidth(thin))"
 89.                 local plot_count = `plot_count' + 3
 90.                 local legend_nums "`legend_nums' `plot_count'"
 91.                 local legend_labels "`legend_labels' label(`plot_count' Female)"
 92.         }
 93.         if `reg_success_m' == 1 {
 94.                 local twoway_cmd "`twoway_cmd' (rcap hi_m lo_m xpos_m, lcolor(bl
> ue%60) lwidth(vthin)) (scatter b_m xpos_m, mcolor(blue%60) msymbol(triangle) msize(
> vsmall)) (line b_m xpos_m if 1==0, lcolor(blue%60) lpattern(solid) lwidth(thin))"
 95.                 local plot_count = `plot_count' + 3
 96.                 local legend_nums "`legend_nums' `plot_count'"
 97.                 local legend_labels "`legend_labels' label(`plot_count' Male)"
 98.         }
 99.         local twoway_cmd "`twoway_cmd', yline(0, lcolor(gs8) lpattern(solid) lwi
> dth(vthin)) xline(6.5, lcolor(yellow) lpattern(dash) lwidth(vthin)) xlabel(`yr_labe
> ls_cod', labsize(small) angle(45) labcolor(black)) xscale(`xscale_range') xtitle(""
> ) ytitle("Mortality Rate, 65+ (per 1,000)", size(medsmall)) ylabel(`yaxis_range', g
> rid gmin gmax labsize(small)) legend(order(`legend_nums') `legend_labels' cols(3) s
> ize(medsmall) position(6) ring(1) region(lcolor(none)) symxsize(5) keygap(1) rowgap
> (0)) graphregion(color(white)) plotregion(margin(l=1 r=1))"
100.         `twoway_cmd'
101.         * graph export "$figures/appendix/`af_stem'.pdf", as(pdf) replace  -- di
> sabled: not displayed in the paper
.         restore
102. 
. } // end foreach cod

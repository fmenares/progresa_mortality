. *------------------------------------------------------------
. * (3) BR's coefficient before and after removing our variation.
. * Panel A: BR's sample (1998/99 entrants, $sample_br) and window
. * (1992-2002). Panel B: our HM sample and window (1991-2006), with
. * Seguro Popular in every regression. BR's treatment is their actual
. * regressor, lag2_intensity_new (intensity two years earlier).
. *   Row 1: fixed effects only (Panel A, col. 1 = Table A5, Panel B)
. *   Row 2: + Intensity_1999 x year dummies
. *   Row 3: + Intensity_2005 x year dummies
. * Panel A only, to name what the leftover is. Within 1992-2002 BR's
. * treatment is 0 through 1999 and equals inten1998, inten1999, inten2000
. * in 2000, 2001, 2002, so Intensity_1999 x year absorbs 2001 exactly and
. * the leftover is the 2000 value (inten1998: entry timing, 1998 vs 1999
. * entrants) and the 2002 value (inten2000: growth in enrollment after
. * 1999). Each row below adds one term to row 2:
. *   Row 4: + entry cohort (inten_start_year) x year dummies
. *   Row 5: + Intensity_1998 x year dummies (absorbs 2000: leftover = 2002)
. *   Row 6: + Intensity_2000 x year dummies (absorbs 2002: leftover = 2000)
. * Adding both rows 5 and 6 would absorb the treatment completely, so
. * they are separate rows.
. * By Frisch-Waugh-Lovell, rows 2-3 are BR's estimate computed only from
. * the part of their treatment those terms do not explain. The "share
. * explained" rows are the partial within-R2 of those terms in a
. * regression of BR's treatment on them (beyond the fixed effects and,
. * in Panel B, Seguro Popular): the share of BR's identifying variation
. * that our design also uses. Note that within 1992-2002, BR's
. * treatment is 0 through 1999 and its 2001 value equals inten1999, so
. * the leftover is the 1998 and 2000 intensities relative to 1999.
. *------------------------------------------------------------
. foreach pnl in A B {
  2.         use `cdid_panel', clear
  3.         if "`pnl'" == "A" {
  4.                 quietly keep if $sample_br & inrange(year, 1992, 2002)
  5.                 local base ""
  6.         }
  7.         else {
  8.                 quietly keep if $sample_marg & inrange(year, 1991, 2006)
  9.                 quietly keep if !missing(sp_intensity)
 10.                 local base "c.sp_intensity"
 11.         }
 12.         quietly keep if !missing(emr65, lag2_intensity_new, inten1999, inten2005, popover65_)
 13.         local ctl1 "`base'"
 14.         local ctl2 "`base' c.inten1999#i.year"
 15.         local ctl3 "`base' c.inten1999#i.year c.inten2005#i.year"
 16.         local nr = 3
 17.         if "`pnl'" == "A" {
 18.                 local ctl4 "`ctl2' i.inten_start_year#i.year"
 19.                 local ctl5 "`ctl2' c.inten1998#i.year"
 20.                 local ctl6 "`ctl2' c.inten2000#i.year"
 21.                 local nr = 6
 22.         }
 23.         foreach wt in uw w {
 24.                 local aw ""
 25.                 if "`wt'" == "w" local aw "[aw=popover65_]"
 26.                 * first-stage baseline: within-R2 of BR's treatment on the base
.                 * controls alone (zero when there are none)
.                 local r2base = 0
 27.                 if "`base'" != "" {
 28.                         quietly reghdfe lag2_intensity_new `base' `aw', a(cve_ent_mun_super year)
 29.                         local r2base = e(r2_within)
 30.                 }
 31.                 forvalues r = 1/`nr' {
 32.                         reghdfe emr65 lag2_intensity_new `ctl`r'' `aw', ///
>                                 a(cve_ent_mun_super year) vce(cluster cve_ent_mun_super)
 33.                         local t = abs(_b[lag2_intensity_new] / _se[lag2_intensity_new])
 34.                         local st ""
 35.                         if `t' >= 1.645 local st "*"
 36.                         if `t' >= 1.960 local st "**"
 37.                         if `t' >= 2.576 local st "***"
 38.                         local b_`pnl'_`wt'_`r' = trim(string(_b[lag2_intensity_new], "%9.3f")) + "`st'
> "
 39.                         local se_`pnl'_`wt'_`r' = trim(string(_se[lag2_intensity_new], "%9.3f"))
 40.                         * rows 4-6 must run on row 1's sample (a missing Intensity 1998
.                         * or 2000 would drop observations silently)
.                         if `r' >= 4 {
 41.                                 if e(N) != `N1' di as error "WARNING: row `r' (`wt') has `=e(N)' obser
> vations vs. `N1' in row 1"
 42.                         }
 43.                         if `r' == 1 {
 44.                                 local N1 = e(N)
 45.                                 local N_`pnl'_`wt' = trim(string(e(N), "%12.0fc"))
 46.                                 tempvar tg
 47.                                 quietly egen `tg' = tag(cve_ent_mun_super) if e(sample)
 48.                                 quietly count if `tg' == 1
 49.                                 local M_`pnl'_`wt' = trim(string(r(N), "%12.0fc"))
 50.                                 drop `tg'
 51.                         }
 52.                         else {
 53.                                 quietly reghdfe lag2_intensity_new `ctl`r'' `aw', a(cve_ent_mun_super 
> year)
 54.                                 local pr2 = (e(r2_within) - `r2base') / (1 - `r2base')
 55.                                 local r2_`pnl'_`wt'_`r' = trim(string(`pr2', "%9.3f"))
 56.                                 di "Panel `pnl', `wt', row `r': share of BR treatment variation explai
> ned = `r2_`pnl'_`wt'_`r''"
 57.                         }
 58.                 }
 59.         }
 60. }

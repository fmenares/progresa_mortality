. 
. foreach pnl in p m f {
  2.         if "`pnl'" == "p" {
  3.                 local dout death65
  4.                 local offc lpopover65
  5.                 local offf lpop96
  6.                 local wv   popover65_
  7.         }
  8.         else if "`pnl'" == "m" {
  9.                 local dout death65m
 10.                 local offc lpopover65_m
 11.                 local offf lpop96_m
 12.                 local wv   popover65_m
 13.         }
 14.         else {
 15.                 local dout death65f
 16.                 local offc lpopover65_f
 17.                 local offf lpop96_f
 18.                 local wv   popover65_f
 19.         }
 20. 
.         foreach c in 1 2 {
 21.                 local bFO_`pnl'_`c'  "n/a"
 22.                 local seFO_`pnl'_`c' "n/a"
 23.                 local NFO_`pnl'_`c'  "n/a"
 24.         }
 25. 
.         * col 1: contemporaneous offset (the standard specification)
.         * col 2: offset fixed at the 1996 pre-program population
.         forval c = 1/2 {
 26.                 if `c' == 1 local offset_use `offc'
 27.                 else        local offset_use `offf'
 28. 
.                 capture ppmlhdfe `dout' c.inten1999#i.post c.inten2005#i.post c.sp_intensity ///
>                         [pw=`wv'] if $sample_marg, a(year cve_ent_mun_super) ///
>                         offset(`offset_use') vce(cluster cve_ent_mun_super)
 29.                 if !_rc & e(N) > 0 {
 30.                         local aux : di %12.2f (exp(_b[1.post#c.inten1999])-1)*100
 31.                         local seFO_`pnl'_`c' : di %12.2f exp(_b[1.post#c.inten1999])*_se[1.post#c.inte
> n1999]*100
 32.                         local t = abs(`aux' / `seFO_`pnl'_`c'')
 33.                         if      `t' >= 2.576 local bFO_`pnl'_`c' = "`aux'***"
 34.                         else if `t' >= 1.96  local bFO_`pnl'_`c' = "`aux'**"
 35.                         else if `t' >= 1.645 local bFO_`pnl'_`c' = "`aux'*"
 36.                         else                  local bFO_`pnl'_`c' = "`aux'"
 37.                         local NFO_`pnl'_`c' : di %12.0fc e(N)
 38.                 }
 39.                 else di as error "Fixed-offset Poisson, panel `pnl', col `c': ppmlhdfe failed or empty
>  sample (rc=`_rc'), leaving cells n/a"
 40.         }
 41. }


. local i = 0

. foreach v in treated_15 treated_med treated_p75 {
  2.     local ++i
  3.     reghdfe emr65 c.`v'#i.post c.sp_intensity ///
>         [aw=popover65_] if $sample_marg, a(year cve_ent_mun_super) vce(cluster cve_ent_mun_super)
  4.     local aux : di %9.3f _b[1.post#c.`v']
  5.     local tstat = abs(_b[1.post#c.`v'] / _se[1.post#c.`v'])
  6.     if      `tstat' >= 2.576 local bt_`i' = trim("`aux'") + "***"
  7.     else if `tstat' >= 1.960 local bt_`i' = trim("`aux'") + "**"
  8.     else if `tstat' >= 1.645 local bt_`i' = trim("`aux'") + "*"
  9.     else                     local bt_`i' = trim("`aux'")
 10.     local set_`i' : di %9.3f _se[1.post#c.`v']
 11.     local Nt_`i'  : di %12.0fc e(N)
 12. }

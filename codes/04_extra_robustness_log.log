. 
. *------------------------------------------------------------
. * (4) Panel A of (3) as paired binned scatters, with the same bins and
. * axes: mortality vs. BR's treatment, both residualized on (fe) the
. * fixed effects only -- slope = row 1 -- and on (i99) the fixed effects
. * plus Intensity_1999 x year -- slope = row 2. The horizontal spread
. * shrinking from (fe) to (i99) shows how much of BR's variation our
. * design shares. 20 quantile bins of the residualized treatment; circle
. * area = mean population 65+ in the bin. Two further diagnostics, run on
. * the same residualized variables inside the loop below:
. *   (4b) af:br_trim -- the same two slopes after trimming 0/1/2/3/5/10%
. *        from each tail of the residualized treatment: AF_br_trim_uw/w
. *   (4c) af:br_size -- the same two slopes within terciles of
. *        municipality size (mean population 65+, 1992-96) and overall:
. *        AF_br_size_uw/w
. *------------------------------------------------------------
. use `cdid_panel', clear

. quietly keep if $sample_br & inrange(year, 1992, 2002)

. quietly keep if !missing(emr65, lag2_intensity_new, inten1999, inten2005, popover65_)

. foreach wt in uw w {
  2.         local aw ""
  3.         if "`wt'" == "w" local aw "[aw=popover65_]"
  4.         quietly gen double __ww = 1
  5.         if "`wt'" == "w" quietly replace __ww = popover65_
  6. 
.         quietly reghdfe emr65 `aw', a(cve_ent_mun_super year) residuals(__y_fe)
  7.         quietly reghdfe lag2_intensity_new `aw', a(cve_ent_mun_super year) residuals(__x_fe)
  8.         quietly reghdfe emr65 c.inten1999#i.year `aw', a(cve_ent_mun_super year) residuals(__y_i99)
  9.         quietly reghdfe lag2_intensity_new c.inten1999#i.year `aw', a(cve_ent_mun_super year) residual
> s(__x_i99)
 10. 
.         * slopes and clustered SEs, identical to (3), Panel A, rows 1-2
.         quietly reghdfe emr65 lag2_intensity_new `aw', ///
>                 a(cve_ent_mun_super year) vce(cluster cve_ent_mun_super)
 11.         local s_fe  = _b[lag2_intensity_new]
 12.         local b_fe  = trim(string(_b[lag2_intensity_new], "%9.2f"))
 13.         local se_fe = trim(string(_se[lag2_intensity_new], "%9.2f"))
 14.         quietly reghdfe emr65 lag2_intensity_new c.inten1999#i.year `aw', ///
>                 a(cve_ent_mun_super year) vce(cluster cve_ent_mun_super)
 15.         local s_i99  = _b[lag2_intensity_new]
 16.         local b_i99  = trim(string(_b[lag2_intensity_new], "%9.2f"))
 17.         local se_i99 = trim(string(_se[lag2_intensity_new], "%9.2f"))
 18. 
.         foreach s in fe i99 {
 19.                 quietly xtile __q_`s' = __x_`s' `aw', nquantiles(20)
 20.                 quietly gen double __wy_`s' = __y_`s' * __ww
 21.                 quietly gen double __wx_`s' = __x_`s' * __ww
 22.                 bysort __q_`s': egen double __sw_`s'  = total(__ww)
 23.                 bysort __q_`s': egen double __swy_`s' = total(__wy_`s')
 24.                 bysort __q_`s': egen double __swx_`s' = total(__wx_`s')
 25.                 bysort __q_`s': egen double __mp_`s'  = mean(popover65_)
 26.                 bysort __q_`s': gen byte __f_`s' = (_n == 1)
 27.                 quietly gen double __by_`s' = __swy_`s' / __sw_`s'
 28.                 quietly gen double __bx_`s' = __swx_`s' / __sw_`s'
 29.         }
 30. 
.         * common axis ranges, so the shrinking spread is visible
.         quietly summarize __bx_fe if __f_fe
 31.         local xlo = r(min)
 32.         local xhi = r(max)
 33.         quietly summarize __bx_i99 if __f_i99
 34.         local xlo = min(`xlo', r(min))
 35.         local xhi = max(`xhi', r(max))
 36.         quietly summarize __by_fe if __f_fe
 37.         local ylo = r(min)
 38.         local yhi = r(max)
 39.         quietly summarize __by_i99 if __f_i99
 40.         local ylo = min(`ylo', r(min))
 41.         local yhi = max(`yhi', r(max))
 42. 
.         foreach s in fe i99 {
 43.                 if "`s'" == "fe" local xt "BR treatment, net of municipality and year fixed effects"
 44.                 else             local xt "BR treatment, also net of Intensity 1999 x year"
 45.                 twoway ///
>                         (scatter __by_`s' __bx_`s' [aw=__mp_`s'] if __f_`s', msymbol(Oh) mcolor(black) ml
> width(thin)) ///
>                         (function y = `s_`s'' * x, range(`xlo' `xhi') lcolor(maroon) lwidth(medthick)), /
> //
>                         xscale(range(`xlo' `xhi')) yscale(range(`ylo' `yhi')) ///
>                         xline(0, lcolor(gs12)) yline(0, lcolor(gs12)) ///
>                         ylabel(, labsize(small) angle(0) glcolor(gs15)) ///
>                         xlabel(, labsize(small)) ///
>                         xtitle("`xt'", size(small)) ///
>                         ytitle("Mortality rate 65+, residualized", size(small)) ///
>                         legend(order(1 "Binned means (20 quantiles; area = population 65+)" 2 "Slope `b_`
> s'' (`se_`s'')") ///
>                                 size(vsmall) rows(1) position(6) ring(1) region(lcolor(white))) ///
>                         graphregion(color(white))
 46.                 graph export "$figures/appendix/AF_br_leftover_`s'_`wt'.pdf", as(pdf) replace
 47.                 if "$repo_figures" != "" graph export "$repo_figures/appendix/AF_br_leftover_`s'_`wt'.
> pdf", as(pdf) replace
 48.                 di "Figure exported to: $figures/appendix/AF_br_leftover_`s'_`wt'.pdf"
 49.         }
 50. 
.         * (4b) trim the tails of the residualized treatment, re-estimate.
.         * Each spec trims on its own residualized treatment (__x_fe, __x_i99);
.         * 0% reproduces the slopes above.
.         local tlist "0 1 2 3 5 10"
 51.         local nt : word count `tlist'
 52.         foreach s in fe i99 {
 53.                 local ctl ""
 54.                 if "`s'" == "i99" local ctl "c.inten1999#i.year"
 55.                 forvalues i = 1/`nt' {
 56.                         local t : word `i' of `tlist'
 57.                         local lo = -1e12
 58.                         local hi =  1e12
 59.                         if `t' > 0 {
 60.                                 quietly _pctile __x_`s' `aw', p(`t' `=100-`t'')
 61.                                 local lo = r(r1)
 62.                                 local hi = r(r2)
 63.                         }
 64.                         quietly reghdfe emr65 lag2_intensity_new `ctl' `aw' if inrange(__x_`s', `lo', 
> `hi'), ///
>                                 a(cve_ent_mun_super year) vce(cluster cve_ent_mun_super)
 65.                         local tb_`s'_`i' = _b[lag2_intensity_new]
 66.                         local tl_`s'_`i' = _b[lag2_intensity_new] - 1.96 * _se[lag2_intensity_new]
 67.                         local th_`s'_`i' = _b[lag2_intensity_new] + 1.96 * _se[lag2_intensity_new]
 68.                 }
 69.         }
 70.         preserve
 71.         clear
 72.         quietly set obs `nt'
 73.         quietly gen byte k = _n
 74.         foreach s in fe i99 {
 75.                 quietly gen double b_`s' = .
 76.                 quietly gen double l_`s' = .
 77.                 quietly gen double h_`s' = .
 78.                 forvalues i = 1/`nt' {
 79.                         quietly replace b_`s' = `tb_`s'_`i'' in `i'
 80.                         quietly replace l_`s' = `tl_`s'_`i'' in `i'
 81.                         quietly replace h_`s' = `th_`s'_`i'' in `i'
 82.                 }
 83.         }
 84.         quietly gen double k_fe  = k - 0.1
 85.         quietly gen double k_i99 = k + 0.1
 86.         local tlab ""
 87.         forvalues i = 1/`nt' {
 88.                 local t : word `i' of `tlist'
 89.                 local tlab `"`tlab' `i' "`t'%""'
 90.         }
 91.         twoway ///
>                 (rcap l_fe h_fe k_fe, lcolor(navy%60)) ///
>                 (connected b_fe k_fe, mcolor(navy) lcolor(navy) msymbol(O)) ///
>                 (rcap l_i99 h_i99 k_i99, lcolor(maroon%60)) ///
>                 (connected b_i99 k_i99, mcolor(maroon) lcolor(maroon) msymbol(D) lpattern(dash)), ///
>                 yline(0, lcolor(gs12)) ///
>                 xscale(range(0.5 `=`nt'+0.5')) xlabel(`tlab', labsize(small)) ///
>                 ylabel(, labsize(small) angle(0) glcolor(gs15)) ///
>                 xtitle("Share trimmed from each tail of the residualized treatment", size(small)) ///
>                 ytitle("Coefficient on BR treatment (95% CI)", size(small)) ///
>                 legend(order(2 "Net of municipality and year fixed effects" ///
>                         4 "Also net of Intensity 1999 x year") size(vsmall) rows(1) position(6) ring(1) r
> egion(lcolor(white))) ///
>                 graphregion(color(white))
 92.         graph export "$figures/appendix/AF_br_trim_`wt'.pdf", as(pdf) replace
 93.         if "$repo_figures" != "" graph export "$repo_figures/appendix/AF_br_trim_`wt'.pdf", as(pdf) re
> place
 94.         di "Figure exported to: $figures/appendix/AF_br_trim_`wt'.pdf"
 95.         restore
 96. 
.         * (4c) the same two regressions within terciles of municipality size
.         * (mean population 65+ over 1992-96), then in the whole sample
.         bysort cve_ent_mun_super: egen double __sz = mean(cond(year <= 1996, popover65_, .))
 97.         egen byte __tag = tag(cve_ent_mun_super)
 98.         quietly xtile __szt = __sz if __tag, nquantiles(3)
 99.         bysort cve_ent_mun_super: egen byte __terc = max(__szt)
100.         local slab ""
101.         forvalues k = 1/4 {
102.                 local cond "if __terc == `k'"
103.                 if `k' == 4 local cond ""
104.                 if `k' < 4 {
105.                         quietly summarize __sz if __tag & __terc == `k'
106.                         local mp`k' = trim(string(r(mean), "%9.0fc"))
107.                         local nm : word `k' of Small Medium Large
108.                         local slab `slab' `k' "`nm'"
109.                 }
110.                 else local slab `slab' 4 "All"
111.                 foreach s in fe i99 {
112.                         local ctl ""
113.                         if "`s'" == "i99" local ctl "c.inten1999#i.year"
114.                         quietly reghdfe emr65 lag2_intensity_new `ctl' `aw' `cond', ///
>                                 a(cve_ent_mun_super year) vce(cluster cve_ent_mun_super)
115.                         local sb_`s'_`k' = _b[lag2_intensity_new]
116.                         local sl_`s'_`k' = _b[lag2_intensity_new] - 1.96 * _se[lag2_intensity_new]
117.                         local sh_`s'_`k' = _b[lag2_intensity_new] + 1.96 * _se[lag2_intensity_new]
118.                 }
119.         }
120.         preserve
121.         clear
122.         quietly set obs 4
123.         quietly gen byte k = _n
124.         foreach s in fe i99 {
125.                 quietly gen double b_`s' = .
126.                 quietly gen double l_`s' = .
127.                 quietly gen double h_`s' = .
128.                 forvalues k = 1/4 {
129.                         quietly replace b_`s' = `sb_`s'_`k'' in `k'
130.                         quietly replace l_`s' = `sl_`s'_`k'' in `k'
131.                         quietly replace h_`s' = `sh_`s'_`k'' in `k'
132.                 }
133.         }
134.         quietly gen double k_fe  = k - 0.1
135.         quietly gen double k_i99 = k + 0.1
136.         twoway ///
>                 (rcap l_fe h_fe k_fe, lcolor(navy%60)) ///
>                 (scatter b_fe k_fe, mcolor(navy) msymbol(O)) ///
>                 (rcap l_i99 h_i99 k_i99, lcolor(maroon%60)) ///
>                 (scatter b_i99 k_i99, mcolor(maroon) msymbol(D)), ///
>                 yline(0, lcolor(gs12)) ///
>                 xscale(range(0.5 4.5)) xlabel(`slab', labsize(small)) ///
>                 ylabel(, labsize(small) angle(0) glcolor(gs15)) ///
>                 xtitle("Size tercile (mean population 65+, 1992-96: `mp1', `mp2', `mp3')", size(small)) /
> //
>                 ytitle("Coefficient on BR treatment (95% CI)", size(small)) ///
>                 legend(order(2 "Net of municipality and year fixed effects" ///
>                         4 "Also net of Intensity 1999 x year") size(vsmall) rows(1) position(6) ring(1) r
> egion(lcolor(white))) ///
>                 graphregion(color(white))
137.         graph export "$figures/appendix/AF_br_size_`wt'.pdf", as(pdf) replace
138.         if "$repo_figures" != "" graph export "$repo_figures/appendix/AF_br_size_`wt'.pdf", as(pdf) re
> place
139.         di "Figure exported to: $figures/appendix/AF_br_size_`wt'.pdf"
140.         restore
141.         drop __*

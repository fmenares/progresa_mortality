> erc)
(68,380 missing values generated)

. replace size_tercile_br = 2 if pop_mun_br_terc > `p33_br' & pop_mun_br_terc <= `p67
> _br'
(5,225 real changes made)

. replace size_tercile_br = 3 if pop_mun_br_terc > `p67_br' & !missing(pop_mun_br_ter
> c)
(5,203 real changes made)

. label define size_tercile_br_lbl 1 "Small" 2 "Medium" 3 "Large", replace

. label values size_tercile_br size_tercile_br_lbl

. 
. forval terc = 1/3 {
  2.     reghdfe emr65 lag2_intensity_new ///
>         if inrange(year, 1992, 2002) & $sample_br & size_tercile_br == `terc', ///
>         a(year cve_ent_mun_super) vce(cluster cve_ent_mun_super)
  3.     local aux: di %12.3f _b[lag2_intensity_new]
  4.     local t = abs(_b[lag2_intensity_new] / _se[lag2_intensity_new])
  5.     if      `t' >= 2.576 local bAT5_terc`terc' = "`aux'***"
  6.     else if `t' >= 1.96  local bAT5_terc`terc' = "`aux'**"
  7.     else if `t' >= 1.645 local bAT5_terc`terc' = "`aux'*"
  8.     else                  local bAT5_terc`terc' = "`aux'"
  9.     local seAT5_terc`terc':   di %12.3f _se[lag2_intensity_new]
 10.     sum emr65 if e(sample) & year == 1996
 11.     local meanAT5_terc`terc': di %12.2fc `r(mean)'
 12.     local NAT5_terc`terc':    di %12.0fc `e(N)'
 13.     distinct cve_ent_mun_super if e(sample)
 14.     local NmunAT5_terc`terc': di %12.0fc `r(ndistinct)'
 15.     quietly sum inten1999 if $sample_br & year == 1996 & size_tercile_br == `ter
> c'
 16.     local meanI99_AT5_terc`terc': di %6.1f r(mean) * 100
 17. }

107.         local plotcmd `"`plotcmd' (connected emr65 year if group_`spec'==3, lcolor(red) mcolor(red) ms
> ymbol(square) msize(small))"'
108.         local legend_order `"`legend_order' `nser' "Never""'
109.     }
110.     if `n_hl_`spec'' > 0 {
111.         local nser = `nser' + 1
112.         local plotcmd `"`plotcmd' (connected emr65 year if group_`spec'==4, lcolor(orange) mcolor(oran
> ge) msymbol(diamond) msize(small))"'
113.         local legend_order `"`legend_order' `nser' "High-Low""'
114.     }
115. 
.     twoway `plotcmd', ///

. * appendix table AT_intensity_construction_comparison (mixed vs.\
. * FASE-cumulative numerator, year-varying denom only, pooled panel only)
. * into ONE table crossing BOTH choices for all three panels, so the
. * denominator fix, the numerator/beneficiary-source fix, and both
. * combined can each be judged against the current-default baseline
. * (column 1) to see which one dominates the main DiD estimate:
. *   Col 1: Mixed numerator,  year-varying denom (current default)
. *   Col 2: FASE numerator,   year-varying denom (numerator fix alone)
. *   Col 3: Mixed numerator,  fixed 1997 P&V denom (denominator fix alone,
. *          the coauthor-preferred main specification)
. *   Col 4: FASE numerator,   fixed 1997 P&V denom (both combined)
. *   Col 5: Same as Col 3, but dropping the `nonmonotone_mix' municipalities
. *          (Intensity_2005 < Intensity_1999 under this construction; see
. *          AT_crosswalk_supermun_diagnostic), since the End-of-year
. *          numerator is not guaranteed monotonic -- this checks whether
. *          those municipalities are driving the column 3 estimate.
. * Output: $tables/T2_b_mortality_fixeddenom.tex
. *============================================================
. foreach pnl in p f m {
  2.     if "`pnl'" == "p" {
  3.         local out65  emr65
  4.         local wt65   popover65_
  5.     }
  6.     else if "`pnl'" == "f" {
  7.         local out65  emr65f
  8.         local wt65   popover65_f
  9.     }
 10.     else {
 11.         local out65  emr65m
 12.         local wt65   popover65_m
 13.     }
 14. 
.     forval c = 1/5 {
 15.         local extracond ""
 16.         if `c' == 1 {
 17.             local inten99v inten1999
 18.             local inten05v inten2005
 19.         }
 20.         else if `c' == 2 {
 21.             local inten99v inten1999_fase
 22.             local inten05v inten2005_fase
 23.         }
 24.         else if `c' == 3 {
 25.             local inten99v inten1999_fix
 26.             local inten05v inten2005_fix
 27.         }
 28.         else if `c' == 4 {
 29.             local inten99v inten1999_fase_fix
 30.             local inten05v inten2005_fase_fix
 31.         }
 32.         else {
 33.             local inten99v inten1999_fix
 34.             local inten05v inten2005_fix
 35.             local extracond "& !nonmonotone_mix"
 36.         }
 37. 
.         local b99_fd_`pnl'_`c'  ""
 38.         local se99_fd_`pnl'_`c' ""
 39.         local b05_fd_`pnl'_`c'  ""
 40.         local se05_fd_`pnl'_`c' ""
 41.         local N_fd_`pnl'_`c'    ""
 42. 
.         cap noisily reghdfe `out65' c.`inten99v'#i.post c.`inten05v'#i.post c.sp_intensity ///
>             [aw=`wt65'] if $sample_marg `extracond', a(year cve_ent_mun_super) vce(cluster cve_ent_mun_su
> per)
 43.         if _rc == 0 & e(N) > 0 {
 44.             local aux : di %12.3f _b[1.post#c.`inten99v']
 45.             * Save the un-starred numeric coefficient under its own name --
.             * `aux' gets reused below for the Intensity_2005 coefficient, so
.             * a persistent copy is needed for the power/MDE table, which
.             * needs the raw number (not the significance-star-annotated
.             * display string in b99_fd_`pnl'_`c').
.             local b99num_fd_`pnl'_`c' "`aux'"
 46.             local t = abs(_b[1.post#c.`inten99v'] / _se[1.post#c.`inten99v'])
 47.             if      `t' >= 2.576 local b99_fd_`pnl'_`c' = "`aux'***"
 48.             else if `t' >= 1.96  local b99_fd_`pnl'_`c' = "`aux'**"
 49.             else if `t' >= 1.645 local b99_fd_`pnl'_`c' = "`aux'*"
 50.             else                  local b99_fd_`pnl'_`c' = "`aux'"
 51.             local se99_fd_`pnl'_`c' : di %12.3f _se[1.post#c.`inten99v']
 52. 
.             local aux : di %12.3f _b[1.post#c.`inten05v']
 53.             local t = abs(_b[1.post#c.`inten05v'] / _se[1.post#c.`inten05v'])
 54.             if      `t' >= 2.576 local b05_fd_`pnl'_`c' = "`aux'***"
 55.             else if `t' >= 1.96  local b05_fd_`pnl'_`c' = "`aux'**"
 56.             else if `t' >= 1.645 local b05_fd_`pnl'_`c' = "`aux'*"
 57.             else                  local b05_fd_`pnl'_`c' = "`aux'"
 58.             local se05_fd_`pnl'_`c' : di %12.3f _se[1.post#c.`inten05v']
 59.             local N_fd_`pnl'_`c' : di %12.0fc e(N)
 60.         }
 61.         else {
 62.             di as error "Panel `pnl', construction `c': reghdfe failed or empty sample (rc=`_rc'), lea
> ving cells blank"
 63.         }
 64.     }
 65. }

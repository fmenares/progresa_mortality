. *------------------------------------------------------------
. * (7) Rows 1, 2 and 4-6 of (3), Panel A, within terciles of municipality
. * size (mean population 65+ over 1992-96, same terciles as af:br_size):
. * AT_br_leftover_size.tex. Shares are the partial within-R2 of BR's
. * treatment on the terms listed, as in (3).
. *------------------------------------------------------------
. use `cdid_panel', clear

. quietly keep if $sample_br & inrange(year, 1992, 2002)

. quietly keep if !missing(emr65, lag2_intensity_new, inten1999, inten2005, popover65_)

. bysort cve_ent_mun_super: egen double __sz = mean(cond(year <= 1996, popover65_, .))

. egen byte __tag = tag(cve_ent_mun_super)

. quietly xtile __szt = __sz if __tag, nquantiles(3)

. bysort cve_ent_mun_super: egen byte __terc = max(__szt)

. forvalues k = 1/3 {
  2.         quietly summarize __sz if __tag & __terc == `k'
  3.         local mp`k' = trim(string(r(mean), "%9.0fc"))
  4. }

. local ctl1 ""

. local ctl2 "c.inten1999#i.year"

. local ctl4 "c.inten1999#i.year i.inten_start_year#i.year"

. local ctl5 "c.inten1999#i.year c.inten1998#i.year"

. local ctl6 "c.inten1999#i.year c.inten2000#i.year"

. foreach wt in uw w {
  2.         local aw ""
  3.         if "`wt'" == "w" local aw "[aw=popover65_]"
  4.         forvalues k = 1/3 {
  5.                 foreach r in 1 2 4 5 6 {
  6.                         reghdfe emr65 lag2_intensity_new `ctl`r'' `aw' if __terc == `k', ///
>                                 a(cve_ent_mun_super year) vce(cluster cve_ent_mun_super)
  7.                         local t = abs(_b[lag2_intensity_new] / _se[lag2_intensity_new])
  8.                         local st ""
  9.                         if `t' >= 1.645 local st "*"
 10.                         if `t' >= 1.960 local st "**"
 11.                         if `t' >= 2.576 local st "***"
 12.                         local zb_`wt'_`k'_`r' = trim(string(_b[lag2_intensity_new], "%9.3f")) + "`st'"
 13.                         local zs_`wt'_`k'_`r' = trim(string(_se[lag2_intensity_new], "%9.3f"))
 14.                         if `r' == 1 {
 15.                                 local zN_`wt'_`k' = trim(string(e(N), "%12.0fc"))
 16.                                 tempvar tg
 17.                                 quietly egen `tg' = tag(cve_ent_mun_super) if e(sample)
 18.                                 quietly count if `tg' == 1
 19.                                 local zM_`wt'_`k' = trim(string(r(N), "%12.0fc"))
 20.                                 drop `tg'
 21.                         }
 22.                         else {
 23.                                 quietly reghdfe lag2_intensity_new `ctl`r'' `aw' if __terc == `k', a(c
> ve_ent_mun_super year)
 24.                                 local zr_`wt'_`k'_`r' = trim(string(e(r2_within), "%9.3f"))
 25.                         }
 26.                 }
 27.         }
 28. }

 93.     local legend_order ""
 94.     local nser = 0
 95.     if `n_early_`spec'' > 0 {
 96.         local nser = `nser' + 1
 97.         local plotcmd `"`plotcmd' (connected emr65 year if group_`spec'==1, lcol

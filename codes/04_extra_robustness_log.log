. *------------------------------------------------------------
. * (2) Implicit regression weights vs. the distribution of the dose
. * (CGBS Table 1), weighted by the 1991-1996 population 65+:
. *   marginal-effect weights  w(l) = E[(D - E[D]) 1{D >= l}] / Var(D)
. *   level-effect weights     v(l) = (l - E[D]) f(l) / Var(D)
. * With no untreated municipalities, w(l) integrates to one and equals
. * the density f(l) when D is normally distributed (Yitzhaki 1996).
. * "Cond" uses the residualized dose from (1), i.e. the variation the
. * regression with the 2005 control actually uses.
. *------------------------------------------------------------
. foreach spec in plain cond {
  2.         if "`spec'" == "plain" {
  3.                 local dv inten1999
  4.                 local dlab "Intensity 1999"
  5.         }
  6.         else {
  7.                 local dv r_inten1999
  8.                 local dlab "Intensity 1999, net of Intensity 2005 and Seguro Popular"
  9.         }
 10.         preserve
 11.         quietly keep if !missing(`dv', w65_pre)
 12.         quietly summarize w65_pre
 13.         local W = r(sum)
 14.         quietly gen double __t = w65_pre * `dv'
 15.         quietly summarize __t
 16.         local mu = r(sum) / `W'
 17.         quietly replace __t = w65_pre * (`dv' - `mu')^2
 18.         quietly summarize __t
 19.         local vd = r(sum) / `W'
 20.         kdensity `dv' [aw=w65_pre], n(100) generate(__gx __fd) nograph
 21.         quietly gen double __wacr = .
 22.         quietly gen double __watt = .
 23.         forvalues i = 1/100 {
 24.                 local l = __gx[`i']
 25.                 quietly replace __t = w65_pre * (`dv' - `mu') * (`dv' >= `l')
 26.                 quietly summarize __t
 27.                 quietly replace __wacr = (r(sum) / `W') / `vd' in `i'
 28.                 quietly replace __watt = (`l' - `mu') * __fd[`i'] / `vd' in `i'
 29.         }
 30.         twoway ///
>                 (line __fd   __gx, lcolor(navy) lwidth(medthick)) ///
>                 (line __wacr __gx, lcolor(maroon) lpattern(shortdash) lwidth(medthick)) ///
>                 (line __watt __gx, lcolor(dkgreen) lpattern(dash) lwidth(medium)), ///
>                 xline(`mu', lcolor(gs8) lpattern(dot)) ///
>                 yline(0, lcolor(gs10) lwidth(thin)) ///
>                 ylabel(, labsize(small) angle(0) glcolor(gs15)) ///
>                 xlabel(, labsize(small)) ///
>                 xtitle("`dlab'", size(small)) ///
>                 ytitle("Density / weight", size(small)) ///
>                 legend(order(1 "Distribution of intensity" ///
>                         2 "Regression weight on marginal effects" ///
>                         3 "Regression weight on level effects") ///
>                         size(vsmall) rows(2) position(6) ring(1) region(lcolor(white))) ///
>                 graphregion(color(white))
 31.         graph export "$figures/appendix/AF_twfe_weights_`spec'.pdf", as(pdf) replace
 32.         if "$repo_figures" != "" graph export "$repo_figures/appendix/AF_twfe_weights_`spec'.pdf", as(
> pdf) replace
 33.         di "Figure exported to: $figures/appendix/AF_twfe_weights_`spec'.pdf"
 34.         restore
 35. }

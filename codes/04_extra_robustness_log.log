> ) lwidth(thin) mcolor(red) msymbol(square) msize(vsmall)) ///
>                                 (line b_m xpos_m if 1==0, lcolor(blue) lpattern(sho
> rtdash_dot) lwidth(thin) mcolor(blue) msymbol(triangle) msize(vsmall)), ///
>                                 yline(0, lcolor(gs8) lpattern(solid) lwidth(vthin))
>  ///
>                                 xline(6.5, lcolor(yellow) lpattern(dash) lwidth(vth
> in)) ///
>                                 xlabel(`yr_labels', labsize(small) angle(45) labcol
> or(black)) ///

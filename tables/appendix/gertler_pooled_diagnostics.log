. foreach ggrp in p m f {
  2.     foreach agecut in 65 51 {
  3.         if "`ggrp'" == "p"      local gcondp "!missing(age_wave) & age_wave>=`ag
> ecut'"
  4.         else if "`ggrp'" == "m" local gcondp "gender==1 & !missing(age_wave) & a
> ge_wave>=`agecut'"
  5.         else                     local gcondp "gender==2 & !missing(age_wave) & 
> age_wave>=`agecut'"
  6. 
.         quietly sum total_visits_pooled if contba==0 & eligible==1 ///
>             & `gcondp' & !missing(total_visits_pooled, contba, claveofi)
  7.         local cmn_`ggrp'_tvp`agecut' : di %9.3f `r(mean)'
  8. 
.         reghdfe total_visits_pooled contba ///
>             if eligible==1 & `gcondp' & !missing(total_visits_pooled, contba, clave
> ofi), ///
>             absorb(clavemun) vce(cluster claveofi)
  9. 
.         di "  [total_visits POOLED `agecut'+, g=`ggrp'] _b[contba] = " _b[contba] "
>   N=" e(N)
 10. 
.         local aux : di %9.3f _b[contba]
 11.         local tstat = abs(_b[contba] / _se[contba])
 12.         if      `tstat' >= 2.576 local b99_`ggrp'_tvp`agecut' = trim("`aux'") + 
> "***"
 13.         else if `tstat' >= 1.960 local b99_`ggrp'_tvp`agecut' = trim("`aux'") + 
> "**"
 14.         else if `tstat' >= 1.645 local b99_`ggrp'_tvp`agecut' = trim("`aux'") + 
> "*"
 15.         else                     local b99_`ggrp'_tvp`agecut' = trim("`aux'")
 16.         local se99_`ggrp'_tvp`agecut' : di %9.3f _se[contba]
 17.         local N_`ggrp'_tvp`agecut'    : di %12.0fc e(N)
 18.     }
 19. }
